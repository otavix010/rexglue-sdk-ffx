+// port diagnostics (PORT_GPU_TRACE set): a line for each command of the submission being executed, the last ones
+// written to the log when the command list's Close fails (DumpPortGpuTrace, from the command processor)
+namespace {
+bool PortGpuTraceOn() {
+  static const bool on = std::getenv("PORT_GPU_TRACE") != nullptr;
+  return on;
+}
+std::deque<std::string>& PortGpuTrace() {
+  static std::deque<std::string> trace;
+  return trace;
+}
+std::string DescribeLocation(const D3D12_TEXTURE_COPY_LOCATION& l) {
+  D3D12_RESOURCE_DESC d = l.pResource->GetDesc();
+  std::string res = fmt::format("res {}x{}x{} fmt {} mips {} dim {}", d.Width, d.Height, d.DepthOrArraySize,
+                                int(d.Format), d.MipLevels, int(d.Dimension));
+  if (l.Type == D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT) {
+    const auto& f = l.PlacedFootprint;
+    return fmt::format("footprint off {} {}x{}x{} pitch {} fmt {} in {}", f.Offset, f.Footprint.Width,
+                       f.Footprint.Height, f.Footprint.Depth, f.Footprint.RowPitch, int(f.Footprint.Format),
+                       res);
+  }
+  return fmt::format("subresource {} of {}", l.SubresourceIndex, res);
+}
+}  // namespace
+
+void DumpPortGpuTrace() {
+  for (const std::string& line : PortGpuTrace()) REXGPU_ERROR("  trace: {}", line);
+  REXGPU_ERROR("  trace: {} commands in the submission", PortGpuTrace().size());
+}
